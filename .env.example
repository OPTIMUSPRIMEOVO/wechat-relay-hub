# Web 前端访问密码 (在 Sony XZ1 Compact 浏览器首次打开时输入)
CLIENT_PASSWORD=xz1c-secret-2026

# PC 与 Android 节点上报消息及连接指令通道的静态密钥
NODE_API_KEY=node-static-key-9527

# PC 节点心跳超时判定秒数 (默认 15 秒未收到心跳则判定 PC_OFFLINE，自动降级至手机节点)
PC_HEARTBEAT_TIMEOUT=15

# 上行消息内存去重时间窗口 (秒)
DEDUP_TTL_SECONDS=5

# SQLite 数据库文件路径
DB_PATH=./data/relay.db

# Cloudflare Tunnel 令牌 (从 Cloudflare Zero Trust -> Networks -> Tunnels 复制)
TUNNEL_TOKEN=eyJhIjoi...your_cloudflare_tunnel_token_here...
